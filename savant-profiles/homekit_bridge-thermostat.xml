      </status_message>
      <status_message name="Units">
        <constant type="character">HK,</constant>
        <data type="character" terminator="," terminator_type="character">
          <update state="ThermostatAddress" type="string"/>
        </data>
        <constant type="character">UNITS,</constant>
        <data type="character" terminator_type="end_of_data">
          <data_map match_required="yes">
            <map key="F">
