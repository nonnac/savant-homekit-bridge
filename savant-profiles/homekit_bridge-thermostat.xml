              <update state="IsCurrentHVACModeAuto" type="boolean">false</update>
              <update state="IsCurrentHVACModeOff" type="boolean">true</update>
            </map>
          </data_map>
        </data>
        <append_data_to_state_names state="ThermostatAddress"/>
      </status_message>
      <status_message name="Running">
        <constant type="character">HK,</constant>
        <data type="character" terminator="," terminator_type="character">
          <update state="ThermostatAddress" type="string"/>
        </data>
        <constant type="character">RUNNING,</constant>
        <data type="character" terminator_type="end_of_data">
          <data_map match_required="yes">
            <map key="HEATING">
              <update state="ThermostatCurrentState" type="string">HEATING</update>
              <update state="IsThermostatControllingHeat" type="boolean">true</update>
              <update state="IsThermostatControllingCool" type="boolean">false</update>
              <update state="IsThermostatIdle" type="boolean">false</update>
            </map>
            <map key="COOLING">
              <update state="ThermostatCurrentState" type="string">COOLING</update>
              <update state="IsThermostatControllingHeat" type="boolean">false</update>
              <update state="IsThermostatControllingCool" type="boolean">true</update>
              <update state="IsThermostatIdle" type="boolean">false</update>
            </map>
            <map key="IDLE">
              <update state="ThermostatCurrentState" type="string">IDLE</update>
              <update state="IsThermostatControllingHeat" type="boolean">false</update>
              <update state="IsThermostatControllingCool" type="boolean">false</update>
              <update state="IsThermostatIdle" type="boolean">true</update>
            </map>
          </data_map>
        </data>
        <append_data_to_state_names state="ThermostatAddress"/>
      </status_message>
      <status_message name="Fan">
        <constant type="character">HK,</constant>
        <data type="character" terminator="," terminator_type="character">
          <update state="ThermostatAddress" type="string"/>
        </data>
        <constant type="character">FAN,</constant>
        <data type="character" terminator_type="end_of_data">
          <data_map match_required="yes">
            <map key="AUTO">
              <update state="ThermostatFanMode" type="string">AUTO</update>
              <update state="IsThermostatCurrentFanModeAuto" type="boolean">true</update>
              <update state="IsThermostatCurrentFanModeOn" type="boolean">false</update>
            </map>
            <map key="ON">
              <update state="ThermostatFanMode" type="string">ON</update>
              <update state="IsThermostatCurrentFanModeAuto" type="boolean">false</update>
              <update state="IsThermostatCurrentFanModeOn" type="boolean">true</update>
