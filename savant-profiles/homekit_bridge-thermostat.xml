        <data type="character" terminator="," terminator_type="character">
          <update state="ThermostatAddress" type="string"/>
        </data>
        <constant type="character">ONLINE,</constant>
        <data type="character" terminator_type="end_of_data">
          <data_map match_required="yes">
            <map key="1">
              <update state="IsThermostatOnline" type="boolean">true</update>
            </map>
            <map key="0">
              <update state="IsThermostatOnline" type="boolean">false</update>
            </map>
          </data_map>
        </data>
        <append_data_to_state_names state="ThermostatAddress"/>
      </status_message>
      <status_message name="Reply">
        <data type="character" terminator_type="end_of_data">
          <update state="LastBridgeReply" type="string"/>
        </data>
      </status_message>
    </status_messages>

